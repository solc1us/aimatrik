# Copy to the ignored repository-root .env.testing; fill credentials locally.
APP_NAME=AIMATRIK
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8001
APP_FORCE_HTTPS=false
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aimatrik_e2e
DB_USERNAME=
DB_PASSWORD=
DB_URL=
TELESCOPE_ENABLED=false
PULSE_ENABLED=false
PW_E2E=1
# Optional PW_BASE_URL override; must match APP_URL and the manually started server.
PW_SUPER_EMAIL=
PW_SUPER_PASSWORD=
PW_ADMIN_A_EMAIL=
PW_ADMIN_A_PASSWORD=
PW_ADMIN_B_EMAIL=
PW_ADMIN_B_PASSWORD=
